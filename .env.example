# Copy file này thành ".env" và điền API key của bạn vào bên dưới.

# --- API-Football (dùng cho chế độ "Theo mùa giải") ---
# Lấy key miễn phí tại: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=dan_key_cua_ban_o_day

# Premier League (Ngoại hạng Anh) có league id = 39 trong API-Football
LEAGUE_ID=39

# Mùa giải muốn lấy dữ liệu — gói free API-Football CHỈ hỗ trợ mùa 2022-2024
# (đã xác nhận: mùa hiện tại/tương lai sẽ báo lỗi "Free plans do not have
# access to this season"). Không đổi ngoài khoảng 2022-2024 nếu dùng gói free.
SEASON=2024

# --- The Odds API (dùng cho chế độ "Trận sắp diễn ra", mặc định) ---
# Lấy key miễn phí (chỉ cần email, không cần thẻ) tại: https://the-odds-api.com
ODDS_API_KEY=dan_key_cua_ban_o_day

# --- football-data.org (dùng cho khối "Dự đoán ML" — phong độ & đối đầu mùa hiện tại) ---
# Lấy key miễn phí (chỉ cần email, không cần thẻ) tại: https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=dan_key_cua_ban_o_day

# --- Firebase Firestore (TUỲ CHỌN — lưu "Bảng sao kê" + "Chốt kèo theo khung"
# bền vững qua mỗi lần Render deploy lại, khỏi cần tải/upload file JSON tay) ---
# Để trống (bỏ qua biến này) nếu chưa muốn dùng Firebase — app vẫn chạy bình
# thường, chỉ là dữ liệu sẽ lưu vào file JSON trong thư mục data/ như trước.
# Cách lấy giá trị: xem hướng dẫn chi tiết trong README.md, mục "Lưu dữ liệu
# bền vững bằng Firebase Firestore". Tóm tắt: tạo project Firebase (free) →
# bật Firestore → tạo service account key (file .json) → base64-encode file
# đó thành 1 dòng duy nhất → dán vào đây.
# FIREBASE_SERVICE_ACCOUNT_BASE64=
