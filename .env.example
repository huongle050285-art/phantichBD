# Copy file này thành ".env" và điền API key của bạn vào bên dưới.

# --- API-Football (dùng cho chế độ "Theo mùa giải") ---
# Lấy key miễn phí tại: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=dan_key_cua_ban_o_day

# Premier League (Ngoại hạng Anh) có league id = 39 trong API-Football
LEAGUE_ID=39

# Mùa giải muốn lấy dữ liệu — gói free API-Football CHỈ hỗ trợ mùa 2022-2024
# (đã xác nhận: mùa hiện tại/tương lai sẽ báo lỗi "Free plans do not have
# access to this season"). Không đổi ngoài khoảng 2022-2024 nếu dùng gói free.
SEASON=2024

# --- The Odds API (dùng cho chế độ "Trận sắp diễn ra", mặc định) ---
# Lấy key miễn phí (chỉ cần email, không cần thẻ) tại: https://the-odds-api.com
ODDS_API_KEY=dan_key_cua_ban_o_day
