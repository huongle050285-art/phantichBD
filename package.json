{
  "name": "epl-odds-project",
  "version": "1.0.0",
  "description": "Lấy dữ liệu lịch thi đấu, tỉ lệ kèo (odds) và dự đoán (predictions) cho giải Ngoại hạng Anh từ API-Football",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "fetch:fixtures": "node src/fetchFixtures.js",
    "fetch:odds": "node src/fetchOdds.js",
    "fetch:predictions": "node src/fetchPredictions.js",
    "fetch:all": "node src/index.js",
    "train": "node scripts/train.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0"
  }
}
